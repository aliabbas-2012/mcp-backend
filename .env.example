# ==============================================================================
# 🐘 LARAVEL BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Kanban MCP Server"

# For Local Testing:
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# For Production (Hostinger):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com

APP_KEY=base64:QXsns6vO7/uAn8xBodNtoWKtMhNVcfKs58wKhFMscoo=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: MySQL on Local (Docker / XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kanban_db
DB_USERNAME=root
DB_PASSWORD=admin

# Option B: MySQL on Hostinger Production (from Hostinger hPanel > MySQL Databases)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_kanban_db
# DB_USERNAME=u123456789_admin
# DB_PASSWORD=YourStrongPasswordHere123!

# ------------------------------------------------------------------------------
# 3. SESSION & CACHE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
